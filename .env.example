# ==============================================================================
# F5 APM Active Directory Password Management Lab - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# F5 BIG-IP TMOS Configuration
# ------------------------------------------------------------------------------
BIGIP_HOST=10.1.1.245
BIGIP_PORT=443
BIGIP_USER=admin
BIGIP_PASS=admin_password
BIGIP_VERIFY_SSL=false
BIGIP_PARTITION=Common

# ------------------------------------------------------------------------------
# Active Directory Domain Controller Configuration
# ------------------------------------------------------------------------------
AD_DOMAIN=lab.example.com
AD_NETBIOS=LAB
AD_DC_IP=10.1.1.10
AD_DC_HOSTNAME=dc01.lab.example.com
AD_LDAPS_PORT=636
AD_BASE_DN=DC=lab,DC=example,DC=com
AD_OU_DN=OU=LabUsers,DC=lab,DC=example,DC=com

# ------------------------------------------------------------------------------
# F5 APM Active Directory Service Account (Delegated Permissions)
# ------------------------------------------------------------------------------
# Minimum required permissions: Reset Password, Read/Write pwdLastSet, Read/Write lockoutTime
AD_SVC_USER=f5-svc-ad
AD_SVC_PASS=AdminServicePass123!

# ------------------------------------------------------------------------------
# F5 APM & LTM Objects Provisioning
# ------------------------------------------------------------------------------
VS_NAME=vs_apm_ad_lab_https
VS_IP=10.1.1.200
VS_PORT=443
APM_PROFILE_NAME=ap_ad_password_mgmt
AAA_AD_NAME=aaa_lab_ad_ldaps
CA_CERT_NAME=lab_ad_ca_cert
CA_CERT_FILE=./certs/lab_root_ca.crt

# ------------------------------------------------------------------------------
# Test Suite User Accounts & Credentials
# ------------------------------------------------------------------------------
# TC-01: Standard User (Non-expired credentials)
TEST_USER_VALID=user_normal
TEST_USER_VALID_PASS=InitialPass123!

# TC-02: Expired User (pwdLastSet = 0 / Must change password at next logon)
TEST_USER_EXPIRED=user_expired
TEST_USER_EXPIRED_PASS=MustChange123!
TEST_USER_EXPIRED_NEW_PASS=ChangedPass123!#

# TC-03: Voluntary Password Change User
TEST_USER_VOLUNTARY=user_voluntary
TEST_USER_VOLUNTARY_PASS=VoluntaryPass123!
TEST_USER_VOLUNTARY_NEW_PASS=VoluntaryNewPass456!#

# TC-04: Locked / Invalid User
TEST_USER_LOCKED=user_locked
TEST_USER_LOCKED_PASS=LockedPass123!
